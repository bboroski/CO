{
  "schema_version": 1,
  "repository": "bboroski/CO",
  "default_base": "main",
  "fallback": "all",
  "fleet": [
    "bboroski/SAMBU",
    "bboroski/ToolNG",
    "bboroski/ReaperCripple",
    "bboroski/Kloz",
    "bboroski/CO",
    "bboroski/SaintSI",
    "bboroski/Klipot",
    "bboroski/NUN",
    "bboroski/NUNLauncher",
    "bboroski/Fragile-Baby",
    "bboroski/Luci",
    "bboroski/Hellduck",
    "bboroski/9circ"
  ],
  "suites": [
    {
      "id": "co-host",
      "description": "Run the documented host tests and repository checks for CO",
      "paths": [
        "**/*.c",
        "**/*.h",
        "**/*.cpp",
        "**/*.hpp",
        "Makefile",
        "**/Makefile",
        "**/*.mk",
        "**/*.py",
        "one.py"
      ],
      "steps": [
        {
          "name": "Run host tests",
          "command": [
            "make",
            "test"
          ],
          "cwd": "."
        },
        {
          "name": "Run repository checks",
          "command": [
            "python",
            "one.py",
            "check"
          ],
          "cwd": "."
        }
      ],
      "runs_on": "ubuntu-latest",
      "timeout_seconds": 1200
    }
  ],
  "policy": {
    "auto_merge": false,
    "required_checks_must_pass": true,
    "draft_prs_block_merge": true,
    "merge_conflicts_block_merge": true,
    "never_bypass_branch_protection": true,
    "no_suite_means_unverified": true
  }
}

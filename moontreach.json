{
  "schema_version": "moontreach.repository.v1",
  "repository": "bboroski/CO",
  "always_run": [
    "repo-check"
  ],
  "fallback_on_unmapped": true,
  "full_suite_on_merge_group": true,
  "max_changed_files": 250,
  "commands": {
    "host-tests": {
      "argv": [
        "make",
        "test"
      ],
      "timeout_seconds": 900
    },
    "repo-check": {
      "argv": [
        "python",
        "one.py",
        "check"
      ],
      "timeout_seconds": 900
    }
  },
  "rules": [
    {
      "id": "c-host-source",
      "paths": [
        "**/*.c",
        "**/*.h",
        "**/*.cpp",
        "**/*.hpp",
        "Makefile",
        "**/Makefile",
        "**/*.mk"
      ],
      "checks": [
        "host-tests",
        "repo-check"
      ]
    },
    {
      "id": "python-checks",
      "paths": [
        "**/*.py",
        "one.py"
      ],
      "checks": [
        "repo-check"
      ]
    },
    {
      "id": "docs-and-workflows",
      "paths": [
        "docs/**",
        "README*",
        ".github/**",
        "moontreach.json"
      ],
      "checks": [
        "repo-check"
      ]
    }
  ],
  "fallback_checks": [
    "host-tests",
    "repo-check"
  ]
}
